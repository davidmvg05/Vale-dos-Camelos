---
// Secção 4: Serviços exclusivos do Vale de Camelos (pt-PT)
---

<section class="py-16 lg:py-6 xl:py-10 bg-[#FAF9F6] relative w-full" id="services">
  <div class="max-w-[1440px] 2xl:max-w-[1560px] mx-auto px-4 sm:px-8 lg:px-12 xl:px-16">
    
    <!-- =========================================================
         TOPO: Tag (sem barra) e Título a Vermelho (#69130D)
         ========================================================= -->
    <div class="max-w-2xl mb-10 sm:mb-12 lg:mb-10">
      <!-- Tag OS NOSSOS SERVIÇOS sem barra -->
      <span class="text-xs font-mono uppercase tracking-widest text-[#7D7D6A] font-semibold block mb-4">
        OS NOSSOS SERVIÇOS
      </span>

      <!-- Título Principal a Vermelho (#69130D) em Português de Portugal -->
      <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-[#69130D] leading-[1.15]">
        Serviços exclusivos desenhados para o seu bem-estar
      </h2>
    </div>

    <!-- =========================================================
         GRELHA: 3 Colunas (Serviços Esquerda | Imagem Central com Borda Vermelha | Serviços Direita)
         ========================================================= -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center">
      
      <!-- COLUNA DA ESQUERDA: 2 Serviços -->
      <div class="lg:col-span-4 flex flex-col justify-between space-y-12 lg:space-y-20">
        
        <!-- Serviço 1: Viagens Personalizadas -->
        <div class="flex flex-col items-center lg:items-center text-center">
          <div class="w-14 h-14 flex items-center justify-center text-[#69130D] mb-4">
            <!-- Ícone Guarda-sol / Praia a Vermelho -->
            <svg class="w-9 h-9" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v18m0-18C7.5 3 4 6.5 4 11h16c0-4.5-3.5-8-8-8zM7 21h10" />
            </svg>
          </div>
          <h3 class="font-serif text-xl sm:text-2xl font-bold text-[#1A1A1A] mb-2">
            Viagens Personalizadas
          </h3>
          <p class="text-xs sm:text-sm text-[#7D7D6A] leading-relaxed max-w-xs">
            Roteiros e itinerários exclusivos desenhados à medida para sentir a alma do Alentejo.
          </p>
        </div>

        <!-- Linha divisória horizontal subtil -->
        <div class="w-full h-[1px] bg-[#69130D]/10 max-w-xs mx-auto"></div>

        <!-- Serviço 2: Transporte Exclusivo -->
        <div class="flex flex-col items-center lg:items-center text-center">
          <div class="w-14 h-14 flex items-center justify-center text-[#69130D] mb-4">
            <!-- Ícone Avião / Transporte a Vermelho -->
            <svg class="w-9 h-9" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <h3 class="font-serif text-xl sm:text-2xl font-bold text-[#1A1A1A] mb-2">
            Transporte Exclusivo
          </h3>
          <p class="text-xs sm:text-sm text-[#7D7D6A] leading-relaxed max-w-xs">
            Desloque-se com total conforto, privacidade e segurança até ao seu refúgio.
          </p>
        </div>

      </div>

      <!-- COLUNA CENTRAL: Fotografia de Destaque Vertical -->
      <div class="lg:col-span-4 flex justify-center">
        <div class="relative aspect-[3/4] sm:aspect-[4/5] lg:aspect-[3/4] w-full max-w-[420px] rounded-2xl lg:rounded-3xl overflow-hidden shadow-2xl bg-black/5">
          <img
            src={`${import.meta.env.BASE_URL}assets/imagem/alojamento/pool.jpg`}
            alt="Piscina panorâmica no Vale de Camelos"
            class="w-full h-full object-cover transition-transform duration-700 hover:scale-105"
            loading="lazy"
          />
        </div>
      </div>

      <!-- COLUNA DA DIREITA: 2 Serviços -->
      <div class="lg:col-span-4 flex flex-col justify-between space-y-12 lg:space-y-20">
        
        <!-- Serviço 3: Alojamento de Charme -->
        <div class="flex flex-col items-center lg:items-center text-center">
          <div class="w-14 h-14 flex items-center justify-center text-[#69130D] mb-4">
            <!-- Ícone Coração / Alojamento a Vermelho -->
            <svg class="w-9 h-9" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
            </svg>
          </div>
          <h3 class="font-serif text-xl sm:text-2xl font-bold text-[#1A1A1A] mb-2">
            Alojamento de Charme
          </h3>
          <p class="text-xs sm:text-sm text-[#7D7D6A] leading-relaxed max-w-xs">
            Aconchego rústico, luz natural e a tranquilidade incomparável da nossa herdade.
          </p>
        </div>

        <!-- Linha divisória horizontal subtil -->
        <div class="w-full h-[1px] bg-[#69130D]/10 max-w-xs mx-auto"></div>

        <!-- Serviço 4: Concierge Dedicado -->
        <div class="flex flex-col items-center lg:items-center text-center">
          <div class="w-14 h-14 flex items-center justify-center text-[#69130D] mb-4">
            <!-- Ícone Auscultadores / Concierge a Vermelho -->
            <svg class="w-9 h-9" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 100-6 3 3 0 000 6z" />
            </svg>
          </div>
          <h3 class="font-serif text-xl sm:text-2xl font-bold text-[#1A1A1A] mb-2">
            Concierge Dedicado
          </h3>
          <p class="text-xs sm:text-sm text-[#7D7D6A] leading-relaxed max-w-xs">
            A nossa equipa está permanentemente atenta a cada detalhe da sua estadia.
          </p>
        </div>

      </div>

    </div>

  </div>
</section>
